# Redis -- the notepad the gateway and this agent share
IASG_REDIS_URL=redis://localhost:6379/0

# The stream the gateway writes (JSON telemetry, one request per entry)
IASG_EVIDENCE_STREAM=iasg:events
IASG_CONSUMER_GROUP=iasg-agent
IASG_CONSUMER_NAME=agent-1
IASG_BATCH_SIZE=500

# How often the decision engine wakes up (proposal says 30-60s)
IASG_INTERVAL_SECONDS=30

# Runtime 60-second windowing uses independent groups, so clean requests remain
# available without changing the campaign evidence consumer.
IASG_ARRIVAL_STREAM=iasg:arrivals
IASG_HEALTH_STREAM=iasg:telemetry:health
IASG_WINDOW_CONSUMER_GROUP=iasg-windowing
IASG_WINDOW_CONSUMER_NAME=window-agent-1
IASG_WINDOW_COMPLETION_GRACE_SECONDS=5

# JSON text or a path to JSON. The documented complete default lives here;
# once Postgres is configured the dashboard's persisted value supersedes it.
# IASG_ADAPTIVE_CONFIG=configs/adaptive.json.example

# Policy writing and its safety rails
IASG_POLICY_PREFIX=policy:
IASG_MAX_IPS_PER_CYCLE=50
IASG_DRY_RUN=false

# Collateral checks, run after a decision is made and before it is written.
# Empty means nothing is declared and nothing is softened -- the default.
#
# Never write policy for these, whatever the evidence says, and whoever asks:
# your own monitors, health checks, office range.
# IASG_ALLOWLIST=203.0.113.9,10.0.0.0/8
#
# Ranges you know are shared by many people -- an office NAT, campus gateway,
# carrier-grade NAT. Slowed if they attack, never cut off.
# IASG_SHARED_RANGES=198.51.100.0/24
#
# Distinct user agents from one address before it is *suspected* of being
# shared. A guess, so it only softens campaigns the evidence was unsure about.
IASG_SHARED_ADDRESS_AGENTS=5

# Human overrides. An admin instructs the agent by writing to this stream:
#   redis-cli XADD iasg_overrides '*' ip 203.0.113.5 action temp_block \
#       actor pranav reason "confirmed attack"
# Actions: monitor, throttle, temp_block, escalate.
IASG_OVERRIDE_STREAM=iasg_overrides
IASG_OVERRIDE_GROUP=iasg-overrides

# What the agent remembers from being overruled. After this many consistent
# corrections on one campaign type it starts making that correction itself --
# by one rung, never more, and never past the checks above.
IASG_FEEDBACK_PREFIX=feedback:
IASG_FEEDBACK_MIN_SAMPLES=2

# Narrative generation. "null" = offline template, no LLM needed.
# Set to "ollama" once the service is running and a model is pulled:
#   brew install ollama && brew services start ollama && ollama pull llama3.2
# The model lives in ~/.ollama, not in this repo -- teammates pull their own.
#
# Running via the Docker stack instead? Ollama ships as an opt-in service
# there (`docker compose --profile llm up -d`, see infra/docker-compose.yml)
# -- configure these in infra/.env, not here; this file is for running
# `python -m iasg` directly against a host-native Ollama.
IASG_LLM_PROVIDER=null
IASG_OLLAMA_URL=http://localhost:11434
IASG_OLLAMA_MODEL=llama3.2
IASG_OLLAMA_TIMEOUT_SECONDS=15
IASG_NARRATION_BUDGET_SECONDS=12

# Durable memory. Optional: unset, campaigns live in Redis under a 24-hour TTL
# and a restart loses them. Set, campaigns and the feedback tallies move to
# Postgres and survive one -- policy keys deliberately stay in Redis, since the
# gateway reads them on the hot path and they are meant to expire.
#
# Needs the driver:  pip install -e ".[postgres]"
#   Compose:         postgresql://iasg_user:changeme@localhost:5434/iasg
#   Local Postgres:  postgresql://iasg_user:changeme@localhost:5432/iasg
# IASG_POSTGRES_URL=postgresql://iasg_user:changeme@localhost:5434/iasg
