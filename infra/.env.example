# Copy to infra/.env. docker-compose.yml reads it automatically; every value
# shown here is already the built-in default, so an empty infra/.env behaves
# identically to having none at all.

# Postgres credentials, read by the postgres/vulnerable_postgres services and
# threaded into control_plane's IASG_POSTGRES_URL.
POSTGRES_USER=iasg_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iasg

# The deliberately vulnerable target uses a separate database. Keeping these
# apart from the security system's store prevents a target compromise from
# becoming access to campaign history.
VULN_POSTGRES_USER=vuln_user
VULN_POSTGRES_PASSWORD=vuln_changeme
VULN_POSTGRES_DB=vuln_app

# Shared by vulnerable_api to sign demo login tokens and by gateway to verify
# them for ownership checks. Replace this before anyone else can reach the stack.
IASG_JWT_SECRET=change-me-before-sharing-this-stack

# Narration. The explanation and assessment agents write the incident prose
# the console shows; off by default so `docker compose up` stays as fast and
# as light as it always was -- nothing downloads, nothing runs.
#
# To opt in:
#   1. docker compose --profile llm up -d      (starts `ollama`, pulls the model)
#   2. IASG_LLM_PROVIDER=ollama                 (uncomment below)
#
# "null" = offline template, no LLM. "ollama" = the containerised model above.
IASG_LLM_PROVIDER=null
# IASG_LLM_PROVIDER=ollama

# Where the control plane looks for the model server.
#   - the container above (default): http://ollama:11434
#   - a native host install (`brew install ollama`), which reaches the GPU
#     and is noticeably faster than the CPU-only container:
#       http://host.docker.internal:11434
IASG_OLLAMA_URL=http://ollama:11434
IASG_OLLAMA_MODEL=llama3.2

# CPU-only inference under Docker on Apple Silicon is slow enough that the
# code's own defaults (15s timeout, 12s per-cycle narration budget) leave
# little room. Keep the budget under IASG_INTERVAL_SECONDS (30s, the control
# plane's cycle length) -- that ceiling is the entire reason budget.py exists.
IASG_OLLAMA_TIMEOUT_SECONDS=30
IASG_NARRATION_BUDGET_SECONDS=25
