          <stringProp name="HTTPSampler.path">/api/orders</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Remember own order ids" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
try {
    def orders = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).orders ?: []
    vars.put(&apos;own_ids&apos;, orders.collect { it.id }.join(&apos;,&apos;))
    vars.put(&apos;first_own_id&apos;, orders ? String.valueOf(orders[0].id) : &apos;1&apos;)
} catch (ignored) {
    vars.put(&apos;own_ids&apos;, &apos;&apos;)
    vars.put(&apos;first_own_id&apos;, &apos;1&apos;)
}
</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="List holds only the caller&apos;s orders" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
if (prev.getResponseCode() != &apos;200&apos;) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;own order list: HTTP ${prev.getResponseCode()}&quot;)
    return
}
def me = vars.get(&apos;user_id&apos;)
def orders = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).orders ?: []
def foreign = orders.findAll { String.valueOf(it.userId) != me }
if (foreign) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;order list contains ${foreign.size()} orders that are not user ${me}&apos;s&quot;)
}
</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Split own ids for re-reading" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
def ids = (vars.get(&apos;own_ids&apos;) ?: &apos;&apos;).split(&apos;,&apos;).findAll { it }
ids.eachWithIndex { id, i -&gt; vars.put(&quot;own_id_${i + 1}&quot;, id) }
SampleResult.setIgnore()
</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
        </JSR223Sampler>
