<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="IASG BOLA: ownership check and object enumeration">
      <stringProp name="TestPlan.comments">Broken Object Level Authorization against the demo shop.
The backend&apos;s GET /api/orders/{id} returns ANY customer&apos;s order to any logged-in user (the bug).
1. A normal shopper logs in and reopens only her own orders: every request must be 200.
2. An attacker logs in with the same kind of account and walks order ids 1..ORDER_IDS.
   Through the gateway, no other customer&apos;s order may come back (404 instead); a forged token must be 401.
   After POLICY_WAIT_MS the control plane&apos;s campaign policy must enforce either a throttle (429s) or a temporary block (403s).
3. The same walk straight to the backend shows the bug is still in the app (other customers&apos; orders return 200).
Thread groups run one after another. Use a fresh ATTACKER_IP for each run.</stringProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(HOST,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(PORT,8082)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BACKEND_HOST" elementType="Argument">
            <stringProp name="Argument.name">BACKEND_HOST</stringProp>
            <stringProp name="Argument.value">${__P(BACKEND_HOST,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BACKEND_PORT" elementType="Argument">
            <stringProp name="Argument.name">BACKEND_PORT</stringProp>
            <stringProp name="Argument.value">${__P(BACKEND_PORT,5002)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RUN_BACKEND_COMPARISON" elementType="Argument">
            <stringProp name="Argument.name">RUN_BACKEND_COMPARISON</stringProp>
            <stringProp name="Argument.value">${__P(RUN_BACKEND_COMPARISON,true)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="EMAIL" elementType="Argument">
            <stringProp name="Argument.name">EMAIL</stringProp>
            <stringProp name="Argument.value">${__P(EMAIL,jane@example.com)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(PASSWORD,user123)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ATTACKER_IP" elementType="Argument">
            <stringProp name="Argument.name">ATTACKER_IP</stringProp>
            <stringProp name="Argument.value">${__P(ATTACKER_IP,203.0.113.230)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NORMAL_IP" elementType="Argument">
            <stringProp name="Argument.name">NORMAL_IP</stringProp>
            <stringProp name="Argument.value">${__P(NORMAL_IP,198.51.100.230)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ORDER_IDS" elementType="Argument">
            <stringProp name="Argument.name">ORDER_IDS</stringProp>
            <stringProp name="Argument.value">${__P(ORDER_IDS,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="POLICY_WAIT_MS" elementType="Argument">
            <stringProp name="Argument.name">POLICY_WAIT_MS</stringProp>
            <stringProp name="Argument.value">${__P(POLICY_WAIT_MS,45000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="POLICY_REQUESTS" elementType="Argument">
            <stringProp name="Argument.name">POLICY_REQUESTS</stringProp>
            <stringProp name="Argument.value">${__P(POLICY_REQUESTS,40)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="1. Normal shopper: reads only her own orders">
