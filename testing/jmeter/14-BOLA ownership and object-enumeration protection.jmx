          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Expect 401" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
prev.setSuccessful(prev.getResponseCode() == &apos;401&apos;)
if (prev.getResponseCode() != &apos;401&apos;) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;forged token got HTTP ${prev.getResponseCode()}, want 401&quot;)
}
</stringProp>
            <stringProp name="parameters"></stringProp>
