          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Keep token and user id" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
def body = prev.getResponseDataAsString()
try {
    def json = new groovy.json.JsonSlurper().parseText(body)
    vars.put(&apos;token&apos;, json.token ?: &apos;&apos;)
    vars.put(&apos;user_id&apos;, String.valueOf(json.user?.id ?: &apos;&apos;))
} catch (ignored) {
    vars.put(&apos;token&apos;, &apos;&apos;)
    vars.put(&apos;user_id&apos;, &apos;&apos;)
}
</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Login returned a token" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
if (prev.getResponseCode() != &apos;200&apos; || !vars.get(&apos;token&apos;)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;login failed (HTTP ${prev.getResponseCode()}): does the backend issue signed tokens? &quot; + prev.getResponseDataAsString().take(200))
}
</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bearer token" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${token}</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Own order list" enabled="true">
          <intProp name="HTTPSampler.connect_timeout">3000</intProp>
          <intProp name="HTTPSampler.response_timeout">5000</intProp>
