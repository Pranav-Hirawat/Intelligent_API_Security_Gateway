        <hashTree/>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Policy check: re-read an own order POLICY_REQUESTS times" enabled="true">
          <stringProp name="LoopController.loops">${POLICY_REQUESTS}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Policy check: GET own order" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
            <intProp name="HTTPSampler.response_timeout">5000</intProp>
            <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
            <stringProp name="HTTPSampler.port">${PORT}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.path">/api/orders/${first_own_id}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Count 200, 429, and 403" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">
def key = prev.getResponseCode() == &apos;429&apos; ? &apos;th_429&apos; : (prev.getResponseCode() == &apos;403&apos; ? &apos;th_403&apos; : (prev.getResponseCode() == &apos;200&apos; ? &apos;th_200&apos; : &apos;th_other&apos;))
vars.put(key, String.valueOf(((vars.get(key) ?: &apos;0&apos;) as int) + 1))
// Either policy action proves the same contract: a prior decision now acts
// without asking the control plane on this request.
prev.setSuccessful(prev.getResponseCode() in [&apos;200&apos;, &apos;403&apos;, &apos;429&apos;])
</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
            </JSR223PostProcessor>
