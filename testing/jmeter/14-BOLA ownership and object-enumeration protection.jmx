        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Policy result: control-plane decision enforced" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
int ok = (vars.get(&apos;th_200&apos;) ?: &apos;0&apos;) as int
int limited = (vars.get(&apos;th_429&apos;) ?: &apos;0&apos;) as int
int blocked = (vars.get(&apos;th_403&apos;) ?: &apos;0&apos;) as int
def line = &quot;after the policy wait: ${ok} x 200, ${limited} x 429, ${blocked} x 403 on GET /api/orders/{id}&quot;
log.info(&apos;[bola] &apos; + line)
SampleResult.setResponseData(line, &apos;UTF-8&apos;)
SampleResult.setResponseMessage(line)
if (limited + blocked == 0) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;500&apos;)
    SampleResult.setResponseMessage(line + &apos; -- no enforced policy. Is ATTACKER_IP trusted (run inside the Compose network), public, and not already used?&apos;)
}
</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
