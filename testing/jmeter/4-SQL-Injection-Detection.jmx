        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Wait for Part A" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def run = props.get(&apos;iasg.sqli.run.id&apos;); long end = System.currentTimeMillis() + 60000
while (props.get(&apos;iasg.sqli.partA.done&apos;) != run &amp;&amp; System.currentTimeMillis() &lt; end) Thread.sleep(100)
if (props.get(&apos;iasg.sqli.partA.done&apos;) != run) { SampleResult.setSuccessful(false); SampleResult.setResponseCode(&apos;500&apos;); SampleResult.setResponseMessage(&apos;Timed out waiting for Part A&apos;) }</stringProp>
