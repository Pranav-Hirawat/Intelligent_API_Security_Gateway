              <stringProp name="script">if (prev.getResponseCode() != &apos;404&apos;) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Expected 404 for C shared path; got &apos; + prev.getResponseCode()) }</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
            </JSR223Assertion>
            <hashTree/>
