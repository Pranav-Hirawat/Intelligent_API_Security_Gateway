        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="A distinct route - expect 404" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
            <intProp name="HTTPSampler.response_timeout">5000</intProp>
