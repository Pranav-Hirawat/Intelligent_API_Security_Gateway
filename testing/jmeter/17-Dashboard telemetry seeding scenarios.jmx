        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Choose next account" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
def accounts = [&apos;admin@shopforge.com&apos;, &apos;jane@example.com&apos;, &apos;admin&apos;, &apos;user1&apos;, &apos;john_doe&apos;]
vars.put(&apos;SPRAY_EMAIL&apos;, accounts[(ctx.getThread().getIteration() - 1) % accounts.size()])
</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
