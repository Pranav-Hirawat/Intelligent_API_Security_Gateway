                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;email&quot;:&quot;${SPRAY_EMAIL}&quot;,&quot;password&quot;:&quot;one-shared-wrong-password&quot;}</stringProp>
