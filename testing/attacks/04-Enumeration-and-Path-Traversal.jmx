<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Attack 04 - Enumeration and path traversal"><stringProp name="TestPlan.comments">Each coordinated address sends one safely bounded probe that contains both the enumeration and traversal signatures. The gateway reflex returns 403 to everything after each hit, so the decision engine sees one probe per address and writes three throttle policies; the more restrictive reflex block still stands, and the follow-up proves it with a 403. Clear policies and let any old reflex expire for 203.0.113.141-143.</stringProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables"><collectionProp name="Arguments.arguments"><elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">${__P(HOST,localhost)}</stringProp></elementProp><elementProp name="PORT" elementType="Argument"><stringProp name="Argument.name">PORT</stringProp><stringProp name="Argument.value">${__P(PORT,8082)}</stringProp></elementProp><elementProp name="POLICY_WAIT_MS" elementType="Argument"><stringProp name="Argument.name">POLICY_WAIT_MS</stringProp><stringProp name="Argument.value">${__P(POLICY_WAIT_MS,50000)}</stringProp></elementProp></collectionProp></elementProp></TestPlan><hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Traversal campaign"><intProp name="ThreadGroup.num_threads">1</intProp><intProp name="ThreadGroup.ramp_time">1</intProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Once"><stringProp name="LoopController.loops">1</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></elementProp></ThreadGroup><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Attacker identity"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Forwarded-For</stringProp><stringProp name="Header.value">${ACTIVE_IP}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">User-Agent</stringProp><stringProp name="Header.value">iasg-traversal-campaign/1.0</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Three signature probes"><stringProp name="LoopController.loops">3</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></LoopController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Attack traversal and enumeration probe"><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/.env-demo?file=public%2F..%2Ffake-config.txt</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"/></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Choose source address"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script"><![CDATA[def ips=['203.0.113.141','203.0.113.142','203.0.113.143']; def n=(vars.get('n') ?: '0') as int; vars.put('ACTIVE_IP',ips[n]); vars.put('n',(n+1).toString())]]></stringProp></JSR223PreProcessor><hashTree/></hashTree></hashTree><TestAction guiclass="TestActionGui" testclass="TestAction" testname="Wait for temporary-block policies"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">${POLICY_WAIT_MS}</stringProp></TestAction><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Follow-up block check"><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/products</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"/></HTTPSamplerProxy><hashTree><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Count follow-up result" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def k=prev.responseCode==&apos;429&apos;?&apos;throttled&apos;:prev.responseCode==&apos;403&apos;?&apos;blocked&apos;:&apos;allowed&apos;; props.put(&apos;iasg.&apos;+k,(((props.get(&apos;iasg.&apos;+k) ?: &apos;0&apos;) as int)+1).toString())</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">false</stringProp></JSR223PostProcessor><hashTree/><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Use first policy address"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">vars.put('ACTIVE_IP','203.0.113.141')</stringProp></JSR223PreProcessor><hashTree/><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Block returns 403"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">if (prev.responseCode!='403') { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Expected 403; got '+prev.responseCode) }</stringProp></JSR223Assertion><hashTree/></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="RESULT - expected policy result"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def n={ (props.get(&apos;iasg.&apos;+it) ?: &apos;0&apos;) as int }; def line=&quot;follow-up -&gt; allowed: ${n(&apos;allowed&apos;)}, throttled: ${n(&apos;throttled&apos;)}, blocked: ${n(&apos;blocked&apos;)}; expected policies: 3 throttle (the gateway reflex block outranks them)&quot;; log.info(&apos;[attack-04] &apos;+line); SampleResult.setResponseData(line,&apos;UTF-8&apos;); if (n(&apos;blocked&apos;) == 0) { SampleResult.setSuccessful(false); SampleResult.setResponseMessage(&apos;FAIL: no follow-up request was blocked (403) -- &apos;+line) } else { SampleResult.setResponseMessage(line) }</stringProp></JSR223Sampler><hashTree/></hashTree><ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report"><stringProp name="filename"></stringProp></ResultCollector><hashTree/></hashTree></hashTree>
</jmeterTestPlan>
