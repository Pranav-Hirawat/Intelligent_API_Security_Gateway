              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">X-Forwarded-For</stringProp>
                <stringProp name="Header.value">203.0.113.111</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">User-Agent</stringProp>
                <stringProp name="Header.value">iasg-sqli-campaign/1.0</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Count attack outcome" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def k=prev.responseCode==&apos;429&apos;?&apos;throttled&apos;:prev.responseCode==&apos;403&apos;?&apos;blocked&apos;:&apos;allowed&apos;; props.put(&apos;iasg.&apos;+k,(((props.get(&apos;iasg.&apos;+k) ?: &apos;0&apos;) as int)+1).toString())</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
