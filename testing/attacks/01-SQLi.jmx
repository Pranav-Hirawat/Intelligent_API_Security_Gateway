        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="SQLi event was persisted" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()); def hits = (body.events ?: []).count { it.ip == &apos;203.0.113.111&apos; &amp;&amp; (it.fired ?: []).contains(&apos;sql_injection&apos;) }; if (prev.responseCode != &apos;200&apos; || hits &lt; 2) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Expected two persisted SQLi events for 203.0.113.111; found &apos; + hits) }</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
