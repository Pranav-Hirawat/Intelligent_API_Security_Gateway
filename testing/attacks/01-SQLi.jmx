            <stringProp name="script">if (prev.responseCode != &apos;403&apos;) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Expected 403 after the temporary-block policy; got &apos; + prev.responseCode) }</stringProp>
