<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Attack 08 - Object ID enumeration BOLA"><stringProp name="TestPlan.comments">Jane logs in, then walks order IDs 1 through 30. The ownership guard prevents foreign data leaks as 404s, while object enumeration crosses its 20-distinct-ID threshold. The combined evidence creates one throttle policy. Clear policy:203.0.113.181 before running.</stringProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables"><collectionProp name="Arguments.arguments"><elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">${__P(HOST,localhost)}</stringProp></elementProp><elementProp name="PORT" elementType="Argument"><stringProp name="Argument.name">PORT</stringProp><stringProp name="Argument.value">${__P(PORT,8082)}</stringProp></elementProp><elementProp name="POLICY_WAIT_MS" elementType="Argument"><stringProp name="Argument.name">POLICY_WAIT_MS</stringProp><stringProp name="Argument.value">${__P(POLICY_WAIT_MS,50000)}</stringProp></elementProp></collectionProp></elementProp></TestPlan><hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="BOLA enumeration and policy proof"><intProp name="ThreadGroup.num_threads">1</intProp><intProp name="ThreadGroup.ramp_time">1</intProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Once"><stringProp name="LoopController.loops">1</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></elementProp></ThreadGroup><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Attacker identity"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Forwarded-For</stringProp><stringProp name="Header.value">203.0.113.181</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">User-Agent</stringProp><stringProp name="Header.value">iasg-bola-enumeration/1.0</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Log in as Jane"><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/login</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><stringProp name="Argument.value">{&quot;email&quot;:&quot;jane@example.com&quot;,&quot;password&quot;:&quot;user123&quot;}</stringProp></elementProp></collectionProp></elementProp></HTTPSamplerProxy><hashTree><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Store signed token"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script"><![CDATA[def json=new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()); vars.put('TOKEN',json.token ?: '')]]></stringProp></JSR223PostProcessor><hashTree/><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Login succeeds"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">if (prev.responseCode!='200' || !vars.get('TOKEN')) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Jane login did not return a token') }</stringProp></JSR223Assertion><hashTree/></hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bearer token"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${TOKEN}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Walk 30 order identifiers"><stringProp name="LoopController.loops">30</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></LoopController><hashTree><CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="Order id"><stringProp name="CounterConfig.start">1</stringProp><stringProp name="CounterConfig.end">30</stringProp><stringProp name="CounterConfig.incr">1</stringProp><stringProp name="CounterConfig.name">ORDER_ID</stringProp><boolProp name="CounterConfig.per_user">true</boolProp></CounterConfig><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Attack object ID walk"><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/orders/${ORDER_ID}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"/></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="No foreign object may be returned"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">if (!(prev.responseCode in ['200','404'])) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Unexpected order-walk status '+prev.responseCode) }</stringProp></JSR223Assertion><hashTree/></hashTree></hashTree><TestAction guiclass="TestActionGui" testclass="TestAction" testname="Wait for throttle policy"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">${POLICY_WAIT_MS}</stringProp></TestAction><hashTree/><LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Consume policy throttle"><stringProp name="LoopController.loops">25</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></LoopController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Follow-up throttle check"><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/products</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"/></HTTPSamplerProxy><hashTree/></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="RESULT - expected policy result"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def line='requests -&gt; allowed: approximately 27, throttled: approximately 5, temp_blocked/escalated: 0; ownership-refused: approximately 24 (404); policies made: 1 (throttle)'; log.info('[attack-08] '+line); SampleResult.setResponseData(line,'UTF-8'); SampleResult.setResponseMessage(line)</stringProp></JSR223Sampler><hashTree/></hashTree><ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report"><stringProp name="filename"></stringProp></ResultCollector><hashTree/></hashTree></hashTree>
</jmeterTestPlan>
